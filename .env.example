# Local development only. Generate real local values with node scripts/infra.mjs init.
# Do not reuse these values in production. Images are pinned in compose.yaml.
COMPOSE_PROJECT_NAME=structured-learning
FRONTEND_PORT=3000
BACKEND_PORT=8000
STORAGE_PORT=9000

POSTGRES_USER=learning
POSTGRES_DB=learning
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_URL=postgresql+psycopg://learning:__POSTGRES_PASSWORD__@postgres:5432/learning
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SECRET_KEY=__SECRET_KEY__
ENCRYPTION_KEY=__ENCRYPTION_KEY__

STORAGE_ENDPOINT=http://storage:9000
STORAGE_ACCESS_KEY=__STORAGE_ACCESS_KEY__
STORAGE_SECRET_KEY=__STORAGE_SECRET_KEY__
STORAGE_REGION=us-east-1
STORAGE_BUCKET=learning-dev
BACKEND_INTERNAL_URL=http://backend:8000

WORKER_APP=app.tasks:celery_app
DEPENDENCY_TIMEOUT=1.5
BACKEND_TIMEOUT_MS=3000
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:3000
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=learning@localhost
# Local development account shortcut; disabled by default.
TEST_LOGIN_ENABLED=false
